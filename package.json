{
  "name": "lenovo-dcsc-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the Lenovo Data Center Solution Configurator (DCSC)",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lenovo-dcsc-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "docs/client-setup.md",
    "examples/client-configs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/mcp/server.js",
    "typecheck": "tsrs -p tsconfig.check.json --noEmit",
    "lint": "oxlint --report-unused-disable-directives --deny-warnings",
    "test": "npm run -s build && vitest run",
    "test:watch": "vitest",
    "mine": "tsx scripts/mine-bundle.ts",
    "contract": "vitest run --config vitest.contract.config.ts",
    "contract:live": "tsx scripts/contract-suite.ts",
    "parity": "tsx scripts/parity/run.ts",
    "prepack": "npm run build",
    "smoke:stdio": "tsx scripts/smoke-stdio.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run contract && npm run smoke:stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "content-disposition": "^0.5.4",
    "fast-xml-parser": "^5.2.5",
    "pino": "^9.6.0",
    "ulid": "^3.0.0",
    "undici": "^7.30.1",
    "yauzl": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/content-disposition": "^0.5.8",
    "@types/node": "^22.13.0",
    "@types/yauzl": "^2.10.3",
    "oxlint": "1.90.0",
    "playwright": "^1.62.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.19.2",
    "typescript": "7.0.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leuquim/lenovo-dcsc-mcp.git"
  }
}
