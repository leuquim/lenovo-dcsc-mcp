{
  "name": "lenovo-dcsc-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the Lenovo Data Center Solution Configurator (DCSC)",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lenovo-dcsc-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "docs/client-setup.md",
    "examples/client-configs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/mcp/server.js",
    "typecheck": "tsrs -p tsconfig.check.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mine": "tsx scripts/mine-bundle.ts",
    "contract": "vitest run --config vitest.contract.config.ts",
    "contract:live": "tsx scripts/contract-suite.ts",
    "parity": "tsx scripts/parity/run.ts",
    "parity:headless": "tsx scripts/parity-headless.ts --suite=all --fresh-catalog --rack-code=7D6DCTO1WW --switch-code=7D5FCTOFWW --automatic-switch-flow",
    "parity:offline": "tsx scripts/parity-headless.ts --suite=offline",
    "parity:recovery": "tsx scripts/parity-recovery.ts --suite=all",
    "parity:projections": "tsx scripts/parity-projections.ts",
    "parity:software": "tsx scripts/parity-software.ts",
    "parity:software-export": "tsx scripts/parity-software-export.ts",
    "parity:software-mixed": "tsx scripts/parity-software-mixed.ts",
    "parity:software-lfo": "tsx scripts/parity-software-lfo.ts",
    "parity:lfo-as-cto": "tsx scripts/parity-lfo-as-cto.ts",
    "parity:rack-lifecycle": "tsx scripts/parity-rack-lifecycle.ts",
    "parity:rack-multiu": "tsx scripts/parity-rack-multiu.ts",
    "parity:workbook-import": "tsx scripts/parity-workbook-import.ts",
    "parity:chassis-clone": "tsx scripts/parity-nested-grouped-import.ts --clone",
    "parity:chassis-parent-edit": "tsx scripts/parity-nested-grouped-import.ts --parent-edit",
    "parity:chassis-linked-copy": "tsx scripts/parity-nested-grouped-import.ts --linked-copy",
    "parity:chassis-member-copy": "tsx scripts/parity-nested-grouped-import.ts --member-copy",
    "parity:chassis-copy": "tsx scripts/parity-nested-grouped-import.ts --copy",
    "parity:nested-grouped-import": "tsx scripts/parity-nested-grouped-import.ts",
    "parity:grouped-rack-import": "tsx scripts/parity-grouped-rack-import.ts",
    "parity:xconfig-import": "tsx scripts/parity-xconfig-import.ts",
    "parity:reference-solutions": "tsx scripts/parity-reference-solutions.ts",
    "parity:unconfigured": "tsx scripts/parity-reference-solutions.ts --edit-unconfigured",
    "parity:rack-lock": "tsx scripts/parity-rack-lock.ts",
    "parity:controls-locale": "tsx scripts/parity-controls-locale.ts",
    "parity:catalogs": "tsx scripts/parity-catalogs.ts",
    "parity:services": "tsx scripts/parity-services.ts",
    "parity:rack-clone": "tsx scripts/parity-rack-clone.ts",
    "parity:switch-clone": "tsx scripts/parity-switch-clone.ts",
    "parity:switch-edit": "tsx scripts/parity-switch-clone.ts --edit",
    "parity:nested-vlh": "tsx scripts/parity-nested-vlh.ts",
    "parity:nested-stdio": "tsx scripts/parity-nested-stdio.ts",
    "parity:nested-removal": "tsx scripts/parity-nested-removal.ts",
    "parity:nested-remove-chassis": "tsx scripts/parity-nested-removal.ts --action=remove-chassis",
    "parity:nested-detach": "tsx scripts/parity-nested-removal.ts --action=remove-node",
    "parity:nested-unplace": "tsx scripts/parity-nested-removal.ts --action=unplace-node",
    "release:checkpoint": "tsx scripts/release-checkpoint.ts",
    "prepack": "npm run build",
    "smoke:stdio": "tsx scripts/smoke-stdio.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run contract && npm run build && npm run smoke:stdio",
    "parity:pci-wizard": "tsx scripts/parity-pci-wizard.ts",
    "parity:storage-wizard": "tsx scripts/parity-storage-wizard.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "content-disposition": "^0.5.4",
    "fast-xml-parser": "^5.2.5",
    "pino": "^9.6.0",
    "ulid": "^3.0.0",
    "undici": "^7.30.1",
    "yauzl": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/content-disposition": "^0.5.8",
    "@types/node": "^22.13.0",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.20.0",
    "playwright": "^1.62.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leuquim/lenovo-dcsc-mcp.git"
  }
}
