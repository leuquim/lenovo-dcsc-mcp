{
  "name": "lenovo-dcsc-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the Lenovo Data Center Solution Configurator (DCSC)",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lenovo-dcsc-mcp": "./dist/mcp/server.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/mcp/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mine": "tsx scripts/mine-bundle.ts",
    "contract": "vitest run --config vitest.contract.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "content-disposition": "^0.5.4",
    "fast-xml-parser": "^5.2.5",
    "pino": "^9.6.0",
    "ulid": "^3.0.0",
    "undici": "^7.10.0",
    "yauzl": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/content-disposition": "^0.5.8",
    "@types/node": "^22.13.0",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
