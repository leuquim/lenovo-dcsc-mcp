{
  "mcpServers": {
    "lenovo-dcsc": {
      "command": "/absolute/path/to/node",
      "args": [
        "/absolute/path/to/lenovo-dcsc-mcp/dist/mcp/server.js"
      ],
      "env": {
        "DCSC_SESSION_FILE": "/absolute/path/to/state/claude-desktop-sessions.json",
        "DCSC_ARTIFACT_DIR": "/absolute/path/to/state/claude-desktop-artifacts"
      }
    }
  }
}
